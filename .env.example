# Environment variables for Hanoi Artisan Bridge
# Copy this file to .env.local and fill in values. Never commit .env or .env.local.
# On the hosting platform set the same names in its environment settings (ADR 0001).

NODE_ENV=development
PORT=3000

# PostgreSQL migration/owner URI, server tools only (db:migrate, db:seed, db:audit). Never use this in
# browser code and do not set it on the web service.
DATABASE_URL=
# Restricted hab_app login provisioned by npm run db:provision-app. The app and test:postgres use it.
# Dev and production should point at DIFFERENT databases (ADR 0001): nothing in the scripts tells them apart.
DATABASE_APP_URL=
# Supabase database CA certificate downloaded from Dashboard > Database Settings (optional; the repo's
# supabase/certs/prod-ca-2021.crt is used when empty).
DATABASE_SSL_CA_FILE=

# Supabase Storage: server only. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hab-private

# Local email adapter. Set to dev-outbox ONLY on a developer laptop: OTP and auth emails are then
# written to .demo-data/otp-outbox/ and .demo-data/auth-outbox/. Do NOT set it in production
# (the production build refuses it and email flows report "Email chưa được cấu hình").
HAB_EMAIL_MODE=

# Test accounts for `npm run db:set-test-passwords` (manual, one-off; ADR 0001, docs/test/test-plan.md).
# Needed only on the laptop that runs the command, not on the web service. Names: 1-20 plain letters/digits,
# comma-separated. Passwords: 8-64 chars with upper, lower, digit, special, no spaces. Set values only in
# .env.local or the shell, never in a committed file.
# Agency accounts t-<name>-agency@example.invalid with company "[T-<Name>] ..."; "Khach" (outsiders) is always added.
HAB_TEST_AGENCY_NAMES=
# One per Agency name, e.g. HAB_TEST_PASSWORD_AGENCY_THU for "Thu"; HAB_TEST_PASSWORD_AGENCY_KHACH for outsiders.
HAB_TEST_PASSWORD_AGENCY_KHACH=
# HDT accounts t-<name>-hdt@example.invalid, only for these names; one HAB_TEST_PASSWORD_HDT_<NAME> each.
HAB_TEST_HDT_NAMES=
# Existing Verified Provider thanhvien19@example.invalid (Xuong thu cong Bat Trang): password only.
HAB_TEST_PASSWORD_PROVIDER=
# Existing UBND thanhvien1@example.invalid (Bat Trang): password only.
HAB_TEST_PASSWORD_UBND=
