    %% =========================================================================
    %% DETAILED ENTITY ATTRIBUTES FOR RATINGS & REVIEWS
    %% =========================================================================

    provider_ratings {
        uuid rating_id PK
        uuid provider_id FK "REFERENCES provider_profiles(provider_id)"
        varchar source_platform "Google Maps, TripAdvisor, Klook, Traveloka, Agoda, Booking.com, Other"
        numeric rating_value "e.g. 4.85"
        numeric rating_scale "5.0 or 10.0"
        numeric normalized_score_100 "Calculated: (rating_value / rating_scale) * 100"
        integer total_reviews "Total review volume on platform"
        text source_url "Direct URL to rating source"
        timestamptz crawled_at "Crawl snapshot timestamp"
        boolean is_latest "true if newest crawl snapshot"
        timestamptz created_at
    }

    provider_reviews {
        uuid review_id PK
        uuid provider_id FK "REFERENCES provider_profiles(provider_id)"
        varchar source_platform "Google Maps, TripAdvisor, Klook, Traveloka, Agoda, Booking.com, Other"
        varchar external_review_id "Unique ID from source platform"
        numeric rating_value "Individual review rating (0.0 - 5.0)"
        numeric rating_scale "Scale (default 5.0)"
        varchar author_display_name "Sanitized public name, NO PII"
        varchar original_language "ISO 639-1 code: vi, en, fr, etc."
        text cleaned_content "Cleaned review body text"
        timestamptz published_at "Platform review publication date"
        timestamptz crawled_at "Timestamp of crawl execution"
        text review_url "URL of review"
        timestamptz created_at
        timestamptz updated_at
    }

    review_sentiment_analyses {
        uuid analysis_id PK
        uuid review_id FK "REFERENCES provider_reviews(review_id) UNIQUE"
        varchar sentiment "Positive, Neutral, Negative"
        numeric sentiment_score "Range: -1.000 to +1.000"
        jsonb sentiment_tags "Array of aspects (e.g. artisan_guidance, workshop_space)"
        jsonb aspect_sentiments "Key-value aspect to sentiment map"
        numeric confidence_score "0.000 to 1.000"
        varchar ai_model_version "e.g. gemini-1.5-pro"
        timestamptz analyzed_at
    }

    provider_quality_scores {
        uuid score_id PK
        uuid provider_id FK "REFERENCES provider_profiles(provider_id)"
        numeric bayesian_rating "Bayesian adjusted rating (0-100)"
        numeric raw_average_rating "Aggregated raw average (0-5.0)"
        integer total_reviews_count "Total review volume across sources"
        numeric volume_score "Log-scaled volume score (0-100)"
        numeric sentiment_score "Aggregated sentiment score (0-100)"
        numeric recency_score "Time-decayed recency score (0-100)"
        numeric final_quality_score "Weighted composite score (0-100)"
        jsonb weight_configuration "Weights JSON: rating 50%, volume 20%, sentiment 20%, recency 10%"
        timestamptz calculated_at
        boolean is_current "true for currently active score"
    }

