# Environment variables for Hanoi Artisan Bridge
# Copy this file to .env.local and fill in values. Never commit .env or .env.local.
# Names only here; real values live in .env.local (laptop) or the hosting platform's settings.

NODE_ENV=development
PORT=3000

# Not used yet: reserved for the PostgreSQL adapter (src/lib/db/client.ts is still a stub;
# the app stores data in the JSON runtime .demo-data/runtime.json).
DATABASE_URL=

# Local email adapter. Set to dev-outbox ONLY on a developer laptop: OTP and auth emails are then
# written to .demo-data/otp-outbox/ and .demo-data/auth-outbox/. Do NOT set it in production
# (the production build refuses it and email flows report "email not configured").
HAB_EMAIL_MODE=

# Hosted test accounts (ADR 0001): at every start the app gives these synthetic seed accounts a real password
# from these variables, without a forced password change. Leave empty on a laptop to keep the
# development-only demo login. On the hosting platform set them in its environment settings, never in a file.
# Rule: 8-64 characters, upper and lower case, a digit, a special character, no spaces.
# thanhvien13@example.invalid  Tour Agency (Cong ty Du lich Trang An)
HAB_TEST_PASSWORD_AGENCY=
# thanhvien19@example.invalid  Local Provider (Xuong thu cong Bat Trang)
HAB_TEST_PASSWORD_PROVIDER=
# thanhvien1@example.invalid   UBND Admin, Bat Trang (active village)
HAB_TEST_PASSWORD_UBND=
# thanhvien9@example.invalid   HDT Admin
HAB_TEST_PASSWORD_HDT=
