# Environment variables for Hanoi Artisan Bridge
# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# OpenAI API (required for AI intent extraction)
OPENAI_API_KEY=mock-key-for-test

# PostgreSQL migration/owner URI, server tools only. Never use this in browser code.
DATABASE_URL=
# Restricted hab_app login provisioned by npm run db:provision-app.
DATABASE_APP_URL=
# Supabase database CA certificate downloaded from Dashboard > Database Settings.
DATABASE_SSL_CA_FILE=

# Google Maps API (required for route/distance calculation)
GOOGLE_MAPS_API_KEY=mock-maps-key

# Supabase Storage: server only. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=hab-private
