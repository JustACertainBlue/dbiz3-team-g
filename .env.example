# Environment variables for Hanoi Artisan Bridge — local development
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# PostgreSQL connection string for the application
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/artisan_bridge

# PostgreSQL admin connection used by Vitest to create and drop test databases.
# Must point to a superuser (e.g. the 'postgres' user).
ADMIN_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres
